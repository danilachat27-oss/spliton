{
  "name": "revshare-platform",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,magenta \"npm run backend:dev\" \"npm run frontend:dev\"",
    "dev:webpack": "concurrently -k -n backend,frontend -c blue,magenta \"npm run backend:dev\" \"npm run frontend:dev:webpack\"",
    "dev:trace": "concurrently -k -n backend,frontend -c blue,magenta \"npm run backend:dev\" \"npm run frontend:dev:trace\"",
    "dev:reset": "npm --prefix apps/frontend run dev:reset",
    "dev:clean": "node scripts/dev-clean-ports.mjs",
    "ports:check": "node scripts/ports-check.mjs",
    "prisma:check-backend": "node scripts/check-backend-for-prisma.mjs",
    "prisma:generate": "node scripts/check-backend-for-prisma.mjs && prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:seed:help-center": "npx tsx prisma/seed-help-center.ts",
    "prisma:seed:staging-qa": "npx tsx apps/backend/scripts/seed-staging-qa.ts",
    "prisma:seed:secondary-market": "npx tsx apps/backend/scripts/seed-secondary-market-starter.ts",
    "finance:ownership-ledger:backfill": "npx tsx scripts/finance/backfill-ownership-ledger.ts",
    "db:deploy": "npm run prisma:migrate:deploy",
    "db:seed": "npm run prisma:seed",
    "db:setup": "npm run prisma:generate && npm run prisma:migrate:deploy && npm run prisma:seed",
    "user:update-password": "node --env-file=.env scripts/update-user-password.mjs",
    "db:diagnose": "node scripts/diagnose-supabase.mjs",
    "db:constraint-prechecks": "node --env-file=.env scripts/db-constraint-prechecks.mjs",
    "frontend:dev": "npm --prefix apps/frontend run dev",
    "frontend:dev:webpack": "npm --prefix apps/frontend run dev:webpack",
    "frontend:dev:trace": "npm --prefix apps/frontend run dev:trace",
    "backend:dev": "npm --prefix apps/backend run start:dev",
    "worker:dev": "npm --prefix apps/backend run start:dev:worker",
    "backend:build": "npm --prefix apps/backend run build",
    "backend:start": "npm --prefix apps/backend run start",
    "backend:test": "npm --prefix apps/backend run test",
    "backend:test:e2e": "npm --prefix apps/backend run test:e2e",
    "backend:lint": "npm --prefix apps/backend run lint:ci",
    "frontend:build": "npm --prefix apps/frontend run build",
    "prisma:validate": "prisma validate",
    "prisma:migrate:diff": "node scripts/prisma-migrate-diff-check.mjs",
    "test:db:setup": "node scripts/test-db-setup.mjs",
    "test:db:setup:seed": "node scripts/test-db-setup.mjs --seed",
    "test:db:cleanup": "node scripts/test-db-cleanup.mjs",
    "test:db:check": "node scripts/test-db-check.mjs",
    "test:db:drift-check": "node scripts/test-db-drift-check.mjs",
    "ci:backend": "npm run prisma:generate && npm run backend:lint && npm run backend:build && npm run backend:test",
    "ci:frontend": "npm run frontend:build",
    "check:production-gaps": "node scripts/check-production-gaps.mjs",
    "ci:e2e": "npm run test:db:check && npm run backend:test:e2e",
    "load:smoke": "node scripts/load-baseline.mjs --mode=smoke",
    "load:baseline": "node scripts/load-baseline.mjs --mode=baseline",
    "load:baseline:auth": "node scripts/load-baseline.mjs --mode=baseline --auth",
    "load:baseline:staging": "node scripts/load-baseline.mjs --mode=baseline --auth",
    "playwright:install": "npm --prefix apps/frontend exec playwright install chromium",
    "playwright:test": "npm --prefix apps/frontend run test:e2e",
    "clean": "node scripts/clean-artifacts.mjs all",
    "clean:frontend": "node scripts/clean-artifacts.mjs frontend",
    "clean:backend": "node scripts/clean-artifacts.mjs backend",
    "clean:e2e": "node scripts/clean-artifacts.mjs e2e",
    "clean:logs": "node scripts/clean-artifacts.mjs logs",
    "analyze:size": "node scripts/analyze-project-size.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prisma": "^6.19.3",
    "tsx": "^4.21.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
