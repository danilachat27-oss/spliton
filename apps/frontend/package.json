{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "node scripts/free-dev-ports.cjs 3000 && next dev -p 3000",
    "dev:webpack": "node scripts/free-dev-ports.cjs 3000 && next dev --webpack -p 3000",
    "dev:turbo": "node scripts/free-dev-ports.cjs 3000 && next dev -p 3000",
    "dev:trace": "node scripts/free-dev-ports.cjs 3000 && node scripts/dev-turbopack-trace.cjs",
    "dev:clean": "node scripts/free-dev-ports.cjs 3000",
    "dev:reset": "node scripts/free-dev-ports.cjs 3000 && node scripts/clean-next-cache.cjs",
    "validate:env": "node scripts/validate-public-env.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretypecheck": "node scripts/clean-next-dev-types.cjs",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck:all": "pnpm run typecheck && pnpm run typecheck:tests && pnpm run typecheck:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/smoke",
    "test:e2e:route-guard": "playwright test e2e/smoke/route-guard.spec.ts",
    "test:e2e:buy-flow": "playwright test e2e/smoke/buy-flow.spec.ts",
    "test:e2e:wallet": "playwright test e2e/smoke/wallet-payouts.spec.ts",
    "test:e2e:secondary": "playwright test e2e/smoke/secondary-market.spec.ts",
    "test:e2e:financial": "playwright test e2e/smoke/buy-flow.spec.ts e2e/smoke/wallet-payouts.spec.ts e2e/smoke/secondary-market.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:unit:i18n": "node scripts/run-i18n-unit-tests.mjs",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "i18n:gate": "node scripts/i18n-release-gate.mjs",
    "i18n:audit:strict-critical": "node scripts/i18n-audit-strict-critical.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.17",
    "cryptocurrency-icons": "^0.18.1",
    "framer-motion": "^12.38.0",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "lightningcss": "^1.32.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.3.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "happy-dom": "^20.0.10",
    "kill-port": "^2.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
