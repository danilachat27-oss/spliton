  earningPeriod         EarningPeriod @relation(fields: [earningPeriodId], references: [id], onDelete: Restrict)
  release               Release       @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  payouts               Payout[]

  @@index([earningPeriodId], map: "earning_distributions_earning_period_id_idx")
  @@index([releaseId], map: "earning_distributions_release_id_idx")
