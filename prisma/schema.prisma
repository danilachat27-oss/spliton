model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  email                   String                   @unique
  passwordHash            String?                  @map("password_hash")
  authProvider            String                   @default("email") @map("auth_provider")
  status                  UserStatus               @default(PENDING)
  emailVerifiedAt         DateTime?                @map("email_verified_at")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  deletedAt               DateTime?                @map("deleted_at")
  profile                 UserProfile?
  userRoles               UserRole[]
  positions               UserPosition[]
  wallets                 Wallet[]
  orders                  Order[]
  marketListings          MarketListing[]
  payouts                 Payout[]
  kycVerifications        KycVerification[]
  sessions                UserSession[]
  notifications           Notification[]
  inAppNotifications      InAppNotification[]
  notificationPreference  NotificationPreference?
  riskFlags               RiskFlag[]
  adminActions            AdminAction[]
  auditLogs               AuditLog[]
  platformFeeSettingsCreated PlatformFeeSetting[]  @relation("platform_fee_created_by")
  platformFeeSettingsUpdated PlatformFeeSetting[]  @relation("platform_fee_updated_by")
  reportJobsRequested       ReportJob[]
  generatedDocuments        GeneratedDocument[]
  tradesBought            Trade[]                  @relation("trade_buyer")
  tradesSold              Trade[]                  @relation("trade_seller")
  ownershipLedger         OwnershipLedger[]
  twoFactorMethods        TwoFactorMethod[]
  twoFactorBackupCodes    TwoFactorBackupCode[]
  twoFactorChallenges     TwoFactorChallenge[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  supportTickets          SupportTicket[]          @relation("support_ticket_user")
  supportTicketsAssigned  SupportTicket[]          @relation("support_ticket_assignee")
  supportTicketNotes      SupportTicketNote[]
  supportTicketMessages   SupportTicketMessage[]
  platformFinancialRulesChanged PlatformFinancialRule[] @relation("financial_rule_changed_by")
  platformFinancialRuleHistory PlatformFinancialRuleHistory[] @relation("financial_rule_history_changed_by")
  newsPostsAuthored       NewsPost[]               @relation("news_post_author")
  newsPostsPublished      NewsPost[]               @relation("news_post_published_by")
  systemStatusComponentsUpdated SystemStatusComponent[] @relation("system_component_updated_by")
  systemStatusIncidentsCreated SystemStatusIncident[] @relation("system_incident_created_by")
  systemStatusUpdatesCreated SystemStatusUpdate[]   @relation("system_status_update_created_by")
  riskFlagsReviewed       RiskFlag[]               @relation("risk_flag_reviewed_by")
  riskFlagsAssigned       RiskFlag[]               @relation("risk_flag_assigned_to")
  complianceNotesAuthored ComplianceNote[]         @relation("compliance_note_author")
  complianceNotesOnUser   ComplianceNote[]         @relation("compliance_note_user")
  complianceFreezesFrozen ComplianceFreeze[]       @relation("compliance_freeze_frozen_by")
  complianceFreezesReleased ComplianceFreeze[]     @relation("compliance_freeze_released_by")
  earningPeriodsApproved  EarningPeriod[]          @relation("earning_period_approved_by")
  earningPeriodHolderSnapshots EarningPeriodHolderSnapshot[]
  systemAlertsAcknowledged SystemAlert[]           @relation("system_alert_acknowledged_by")
  systemAlertsResolved     SystemAlert[]           @relation("system_alert_resolved_by")
  marketWatchlistItems     MarketWatchlistItem[]
  legalConsents            UserLegalConsent[]
  adminUpdatesCreated      AdminUpdateAnnouncement[]  @relation("admin_update_created_by")
  adminUpdatesUpdated      AdminUpdateAnnouncement[]  @relation("admin_update_updated_by")
  adminUpdateReads         AdminUpdateRead[]
  amlProfile               UserAmlProfile?
  legalPoliciesCreated     LegalPolicy[]            @relation("legal_policy_created_by")
  legalPoliciesUpdated     LegalPolicy[]            @relation("legal_policy_updated_by")
  legalPoliciesApproved    LegalPolicy[]            @relation("legal_policy_approved_by")
  withdrawalApprovals      WithdrawalApproval[]     @relation("withdrawal_approvals")
  systemAnnouncementsCreated SystemAnnouncement[]   @relation("system_announcement_created_by")
  systemAnnouncementsUpdated SystemAnnouncement[]   @relation("system_announcement_updated_by")
  systemAnnouncementsPublished SystemAnnouncement[] @relation("system_announcement_published_by")
  systemAnnouncementDismissals SystemAnnouncementDismissal[]
  artistUserLink               ArtistUserLink?
  disputes                     Dispute[]                     @relation("dispute_user")
  disputesAssigned             Dispute[]                     @relation("dispute_assignee")
  disputeMessages              DisputeMessage[]
  releaseSubmissions           ReleaseSubmission[]           @relation("release_submission_user")
  releaseSubmissionsReviewed   ReleaseSubmission[]           @relation("release_submission_reviewer")
  operatorSlaTasksAssigned     OperatorSlaTask[]             @relation("operator_sla_assignee")
  onboardingState              UserOnboardingState?
  securityPreference           UserSecurityPreference?
  referralProfile              ReferralProfile?
  referralAttributionAsReferred ReferralAttribution?  @relation("referral_referred")
  referralAttributionsAsReferrer ReferralAttribution[] @relation("referral_referrer")
  referralRewardsAsReferrer    ReferralReward[]       @relation("referral_reward_referrer")
  referralRewardsAsReferred    ReferralReward[]       @relation("referral_reward_referred")
  partnerProfile               PartnerProfile?
  helpArticlesAuthored         HelpArticle[]                 @relation("help_article_author")

  @@index([createdAt], map: "users_created_at_idx")
  @@map("users")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  ip        String?
  userAgent String?   @map("user_agent")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt], map: "email_verification_tokens_user_id_used_at_expires_at_idx")
  @@index([expiresAt], map: "email_verification_tokens_expires_at_idx")
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  ip        String?
  userAgent String?   @map("user_agent")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt], map: "password_reset_tokens_user_id_used_at_expires_at_idx")
  @@index([expiresAt], map: "password_reset_tokens_expires_at_idx")
  @@map("password_reset_tokens")
}

model TwoFactorMethod {
  id                   String                @id @default(uuid()) @db.Uuid
  userId               String                @map("user_id") @db.Uuid
  methodType           TwoFactorMethodType   @map("method_type")
  status               TwoFactorMethodStatus
  secretCiphertext     String                @map("secret_ciphertext")
  secretIv             String                @map("secret_iv")
  secretTag            String                @map("secret_tag")
  encryptionKeyVersion Int                   @default(1) @map("encryption_key_version")
  confirmedAt          DateTime?             @map("confirmed_at")
  lastUsedAt           DateTime?             @map("last_used_at")
  disabledAt           DateTime?             @map("disabled_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, methodType], map: "two_factor_methods_user_id_method_type_key")
  @@index([userId, status], map: "two_factor_methods_user_id_status_idx")
  @@map("two_factor_methods")
}

model TwoFactorBackupCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt], map: "two_factor_backup_codes_user_id_used_at_idx")
  @@map("two_factor_backup_codes")
}

model TwoFactorChallenge {
  id            String                   @id @default(uuid()) @db.Uuid
  userId        String                   @map("user_id") @db.Uuid
  status        TwoFactorChallengeStatus @default(PENDING)
  attemptsCount Int                      @default(0) @map("attempts_count")
  expiresAt     DateTime                 @map("expires_at")
  consumedAt    DateTime?                @map("consumed_at")
  ip            String?
  userAgent     String?                  @map("user_agent")
  createdAt     DateTime                 @default(now()) @map("created_at")
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt], map: "two_factor_challenges_user_id_status_expires_at_idx")
  @@index([expiresAt], map: "two_factor_challenges_expires_at_idx")
  @@map("two_factor_challenges")
}

model UserProfile {
  userId            String    @id @map("user_id") @db.Uuid
  displayName       String?   @map("display_name")
  firstName         String?   @map("first_name")
  lastName          String?   @map("last_name")
  countryCode       String?   @map("country_code")
  timezone          String?   @map("timezone")
  preferredLocale   AppLocale @default(ru) @map("preferred_locale")
  passwordChangedAt DateTime? @map("password_changed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSecurityPreference {
  userId                              String   @id @map("user_id") @db.Uuid
  withdrawalEmailConfirmationEnabled  Boolean  @default(false) @map("withdrawal_email_confirmation_enabled")
  withdrawalAddressWhitelistEnabled   Boolean  @default(false) @map("withdrawal_address_whitelist_enabled")
  suspiciousLoginAlertsEnabled        Boolean  @default(true) @map("suspicious_login_alerts_enabled")
  createdAt                           DateTime @default(now()) @map("created_at")
  updatedAt                           DateTime @updatedAt @map("updated_at")
  user                                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_security_preferences")
}

model UserOnboardingState {
  userId        String    @id @map("user_id") @db.Uuid
  dismissedAt   DateTime? @map("dismissed_at")
  completedAt   DateTime? @map("completed_at")
  stepOverrides Json?     @map("step_overrides")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_onboarding_state")
}

model Role {
  id        String       @id @default(uuid()) @db.Uuid
  code      UserRoleCode @unique
  name      String
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId], map: "user_roles_user_id_role_id_key")
  @@index([roleId], map: "user_roles_role_id_idx")
  @@map("user_roles")
}

model Artist {
  id             String          @id @default(uuid()) @db.Uuid
  slug           String          @unique
  name           String
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  releaseArtists ReleaseArtist[]
  userLinks      ArtistUserLink[]

  @@map("artists")
}

model Label {
  id        String    @id @default(uuid()) @db.Uuid
  slug      String    @unique
  name      String
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  releases  Release[]

  @@map("labels")
}

model ReleaseGenre {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  releases  Release[]

  @@map("release_genres")
}

model Release {
  id                    String                     @id @default(uuid()) @db.Uuid
  slug                  String                     @unique
  symbol                String                     @unique
  title                 String
  segment               String?
  status                ReleaseStatus              @default(DRAFT)
  payoutFrequency       PayoutFrequency            @map("payout_frequency")
  totalUnits            Decimal                    @map("total_units") @db.Decimal(20, 8)
  unitsAvailablePrimary Decimal                    @map("units_available_primary") @db.Decimal(20, 8)
  primaryUnitPrice      Decimal                    @map("primary_unit_price") @db.Decimal(20, 8)
  coverUrl              String?                    @map("cover_url")
  videoUrl              String?                    @map("video_url")
  videoPosterUrl        String?                    @map("video_poster_url")
  videoType             ReleaseVideoType           @default(NONE) @map("video_type")
  videoStatus           ReleaseVideoStatus         @default(NONE) @map("video_status")
  shortDescription      String?                    @map("short_description") @db.Text
  genre                 String?
  genreId               String?                    @map("genre_id") @db.Uuid
  description           String?                    @db.Text
  riskDisclosureText    String?                    @map("risk_disclosure_text") @db.Text
  legalDisclaimer       String?                    @map("legal_disclaimer") @db.Text
  secondaryEnabled      Boolean                    @default(true) @map("secondary_enabled")
  publicStatus          String?                    @map("public_status")
  audioPreviewUrl       String?                    @map("audio_preview_url")
  releaseDate           DateTime?                  @map("release_date") @db.Date
  releaseType           String?                    @map("release_type")
  copyrightOwner        String?                    @map("copyright_owner")
  isrc                  String?
  upc                   String?
  spotifyUrl            String?                    @map("spotify_url")
  appleMusicUrl           String?                    @map("apple_music_url")
  youtubeUrl            String?                    @map("youtube_url")
  yandexMusicUrl        String?                    @map("yandex_music_url")
  minPurchaseUnits      Decimal?                   @map("min_purchase_units") @db.Decimal(20, 8)
  maxPurchaseUnits      Decimal?                   @map("max_purchase_units") @db.Decimal(20, 8)
  distributionNotes     String?                    @map("distribution_notes") @db.Text
  platformSharePct      Decimal?                   @map("platform_share_pct") @db.Decimal(10, 6)
  artistSharePct        Decimal?                   @map("artist_share_pct") @db.Decimal(10, 6)
  holderSharePct        Decimal?                   @map("holder_share_pct") @db.Decimal(10, 6)
  raiseTargetUsdt       Decimal?                   @map("raise_target_usdt") @db.Decimal(20, 8)
  hardCapUsdt           Decimal?                   @map("hard_cap_usdt") @db.Decimal(20, 8)
  promoBudgetUsdt       Decimal?                   @map("promo_budget_usdt") @db.Decimal(20, 8)
  artistUpfrontUsdt     Decimal?                   @map("artist_upfront_usdt") @db.Decimal(20, 8)
  platformUpfrontUsdt   Decimal?                   @map("platform_upfront_usdt") @db.Decimal(20, 8)
  labelId               String?                    @map("label_id") @db.Uuid
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @updatedAt @map("updated_at")
  deletedAt             DateTime?                  @map("deleted_at")
  label                 Label?                     @relation(fields: [labelId], references: [id], onDelete: SetNull)
  releaseGenre          ReleaseGenre?              @relation(fields: [genreId], references: [id], onDelete: SetNull)
  releaseArtists        ReleaseArtist[]
  releaseMetricsDaily   ReleaseMetricsDaily[]
  releaseShareLots      ReleaseShareLot[]
  releaseDocuments      ReleaseDocument[]
  releaseAnalyticsSnaps ReleaseAnalyticsSnapshot[]
  marketListings        MarketListing[]
  orders                Order[]
  trades                Trade[]
  priceHistory          PriceHistory[]
  userPositions         UserPosition[]
  ownershipLedger       OwnershipLedger[]
  earningPeriods        EarningPeriod[]
  earningDistributions  EarningDistribution[]
  earningPeriodHolderSnapshots EarningPeriodHolderSnapshot[]
  payouts               Payout[]
  orderBookSnapshots    OrderBookSnapshot[]
  primaryRaiseRounds    PrimaryRaiseRound[]
  marketWatchlistItems  MarketWatchlistItem[]
  approvalSteps         ReleaseApprovalStep[]
  submissions           ReleaseSubmission[]
  faqItems              ReleaseFaqItem[]

  @@index([status, createdAt], map: "releases_status_created_at_idx")
  @@index([status], map: "releases_public_status_idx")
  @@index([genreId], map: "releases_genre_id_idx")
  @@index([labelId], map: "releases_label_id_idx")
  @@map("releases")
}

model ReleaseFaqItem {
  id          String    @id @default(uuid()) @db.Uuid
  releaseId   String?   @map("release_id") @db.Uuid
  question    String    @db.Text
  answer      String    @db.Text
  locale      AppLocale @default(ru)
  category    String?
  sortOrder   Int       @default(0) @map("sort_order")
  isPublished Boolean   @default(false) @map("is_published")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  release     Release?  @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId, locale, isPublished], map: "release_faq_items_release_locale_published_idx")
  @@map("release_faq_items")
}

model ReleaseArtist {
  id        String            @id @default(uuid()) @db.Uuid
  releaseId String            @map("release_id") @db.Uuid
  artistId  String            @map("artist_id") @db.Uuid
  role      ArtistReleaseRole
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  release   Release           @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  artist    Artist            @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([releaseId, artistId, role], map: "release_artists_release_id_artist_id_role_key")
  @@index([artistId], map: "release_artists_artist_id_idx")
  @@map("release_artists")
}

model ReleaseMetricsDaily {
  id                String   @id @default(uuid()) @db.Uuid
  releaseId         String   @map("release_id") @db.Uuid
  asOfDate          DateTime @map("as_of_date") @db.Date
  yieldPct          Decimal? @map("yield_pct") @db.Decimal(10, 6)
  payoutsTotal      Decimal? @map("payouts_total") @db.Decimal(20, 8)
  activityScore     Decimal? @map("activity_score") @db.Decimal(10, 4)
  liquidityScore    Decimal? @map("liquidity_score") @db.Decimal(10, 4)
  volume24hNotional Decimal? @map("volume_24h_notional") @db.Decimal(20, 8)
  volume24hUnits    Decimal? @map("volume_24h_units") @db.Decimal(20, 8)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  release           Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([releaseId, asOfDate], map: "release_metrics_daily_release_id_as_of_date_key")
  @@index([releaseId, asOfDate], map: "release_metrics_daily_release_id_as_of_date_idx")
  @@map("release_metrics_daily")
}

model ReleaseShareLot {
  id             String       @id @default(uuid()) @db.Uuid
  releaseId      String       @map("release_id") @db.Uuid
  lotType        ShareLotType @map("lot_type")
  unitsTotal     Decimal      @map("units_total") @db.Decimal(20, 8)
  unitsRemaining Decimal      @map("units_remaining") @db.Decimal(20, 8)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  release        Release      @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId, lotType], map: "release_share_lots_release_id_lot_type_idx")
  @@map("release_share_lots")
}

model UserPosition {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  releaseId      String   @map("release_id") @db.Uuid
  unitsTotal     Decimal  @map("units_total") @db.Decimal(20, 8)
  unitsAvailable Decimal  @map("units_available") @db.Decimal(20, 8)
  unitsLocked    Decimal  @map("units_locked") @db.Decimal(20, 8)
  avgEntryPrice  Decimal  @map("avg_entry_price") @db.Decimal(20, 8)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  release        Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([userId, releaseId], map: "user_positions_user_id_release_id_key")
  @@index([releaseId], map: "user_positions_release_id_idx")
  @@index([userId, releaseId], map: "user_positions_user_id_release_id_idx")
  @@map("user_positions")
}

model MarketListing {
  id             String        @id @default(uuid()) @db.Uuid
  releaseId      String        @map("release_id") @db.Uuid
  sellerUserId   String        @map("seller_user_id") @db.Uuid
  listingType    String        @default("standard") @map("listing_type")
  pricePerUnit   Decimal       @map("price_per_unit") @db.Decimal(20, 8)
  unitsTotal     Decimal       @map("units_total") @db.Decimal(20, 8)
  unitsAvailable Decimal       @map("units_available") @db.Decimal(20, 8)
  status         ListingStatus
  expiresAt      DateTime?     @map("expires_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")
  release        Release       @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  seller         User          @relation(fields: [sellerUserId], references: [id], onDelete: Restrict)
  orders         Order[]

  @@index([releaseId, status], map: "market_listings_release_id_status_idx")
  @@index([sellerUserId, status], map: "market_listings_seller_user_id_status_idx")
  @@map("market_listings")
}

model MarketWatchlistItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  releaseId String   @map("release_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([userId, releaseId], map: "market_watchlist_user_release_key")
  @@index([userId], map: "market_watchlist_user_id_idx")
  @@index([releaseId], map: "market_watchlist_release_id_idx")
  @@map("market_watchlist_items")
}

model Order {
  id                 String         @id @default(uuid()) @db.Uuid
  userId             String         @map("user_id") @db.Uuid
  releaseId          String         @map("release_id") @db.Uuid
  listingId          String?        @map("listing_id") @db.Uuid
  primaryRaiseRoundId String?       @map("primary_raise_round_id") @db.Uuid
  idempotencyKey     String?        @map("idempotency_key")
  side               OrderSide
  orderType          OrderType      @map("order_type")
  timeInForce        TimeInForce    @map("time_in_force")
  priceLimit         Decimal?       @map("price_limit") @db.Decimal(20, 8)
  unitsTotal         Decimal        @map("units_total") @db.Decimal(20, 8)
  unitsFilled        Decimal        @map("units_filled") @db.Decimal(20, 8)
  grossAmount        Decimal?       @map("gross_amount") @db.Decimal(20, 8)
  feeAmount          Decimal?       @map("fee_amount") @db.Decimal(20, 8)
  netAmount          Decimal?       @map("net_amount") @db.Decimal(20, 8)
  unitPrice          Decimal?       @map("unit_price") @db.Decimal(20, 8)
  status             OrderStatus
  failureReason      String?        @map("failure_reason")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  cancelledAt   DateTime?      @map("cancelled_at")
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  release       Release        @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  listing       MarketListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  fills         OrderFill[]
  buyTrades     Trade[]        @relation("trade_buy_order")
  sellTrades    Trade[]        @relation("trade_sell_order")

  @@unique([userId, idempotencyKey], map: "orders_user_id_idempotency_key_key")
  @@index([primaryRaiseRoundId], map: "orders_primary_raise_round_id_idx")
  @@index([userId, createdAt], map: "orders_user_id_created_at_idx")
  @@index([releaseId, status, side], map: "orders_release_id_status_side_idx")
  @@index([releaseId, createdAt(sort: Desc)], map: "orders_release_id_created_at_idx")
  @@index([status], map: "orders_status_idx")
  @@index([createdAt], map: "orders_created_at_idx")
  @@map("orders")
}

model Trade {
  id               String                @id @default(uuid()) @db.Uuid
  releaseId        String                @map("release_id") @db.Uuid
  buyOrderId       String                @map("buy_order_id") @db.Uuid
  sellOrderId      String                @map("sell_order_id") @db.Uuid
  buyerUserId      String                @map("buyer_user_id") @db.Uuid
  sellerUserId     String                @map("seller_user_id") @db.Uuid
  price            Decimal               @db.Decimal(20, 8)
  units            Decimal               @db.Decimal(20, 8)
  grossAmount      Decimal               @map("gross_amount") @db.Decimal(20, 8)
  feeTotal         Decimal               @map("fee_total") @db.Decimal(20, 8)
  settlementStatus TradeSettlementStatus @map("settlement_status")
  executedAt       DateTime              @map("executed_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  release          Release               @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  buyOrder         Order                 @relation("trade_buy_order", fields: [buyOrderId], references: [id], onDelete: Restrict)
  sellOrder        Order                 @relation("trade_sell_order", fields: [sellOrderId], references: [id], onDelete: Restrict)
  buyer            User                  @relation("trade_buyer", fields: [buyerUserId], references: [id], onDelete: Restrict)
  seller           User                  @relation("trade_seller", fields: [sellerUserId], references: [id], onDelete: Restrict)
  orderFills       OrderFill[]
  ownershipLedger  OwnershipLedger[]

  @@index([releaseId, executedAt], map: "trades_release_id_executed_at_idx")
  @@index([buyerUserId, executedAt(sort: Desc)], map: "trades_buyer_user_id_executed_at_idx")
  @@index([sellerUserId, executedAt(sort: Desc)], map: "trades_seller_user_id_executed_at_idx")
  @@index([buyOrderId], map: "trades_buy_order_id_idx")
  @@index([sellOrderId], map: "trades_sell_order_id_idx")
  @@map("trades")
}

model OrderFill {
  id              String            @id @default(uuid()) @db.Uuid
  orderId         String            @map("order_id") @db.Uuid
  tradeId         String            @map("trade_id") @db.Uuid
  side            OrderSide
  units           Decimal           @db.Decimal(20, 8)
  price           Decimal           @db.Decimal(20, 8)
  grossAmount     Decimal           @map("gross_amount") @db.Decimal(20, 8)
  feeAmount       Decimal           @map("fee_amount") @db.Decimal(20, 8)
  netAmount       Decimal           @map("net_amount") @db.Decimal(20, 8)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  trade           Trade             @relation(fields: [tradeId], references: [id], onDelete: Restrict)
  ownershipLedger OwnershipLedger[]

  @@unique([tradeId, orderId], map: "order_fills_trade_id_order_id_key")
  @@index([orderId], map: "order_fills_order_id_idx")
  @@index([tradeId], map: "order_fills_trade_id_idx")
  @@map("order_fills")
}

model PriceHistory {
  id             String      @id @default(uuid()) @db.Uuid
  releaseId      String      @map("release_id") @db.Uuid
  bucket         PriceBucket
  ts             DateTime
  openPrice      Decimal     @map("open_price") @db.Decimal(20, 8)
  highPrice      Decimal     @map("high_price") @db.Decimal(20, 8)
  lowPrice       Decimal     @map("low_price") @db.Decimal(20, 8)
  closePrice     Decimal     @map("close_price") @db.Decimal(20, 8)
  volumeUnits    Decimal     @map("volume_units") @db.Decimal(20, 8)
  volumeNotional Decimal     @map("volume_notional") @db.Decimal(20, 8)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  release        Release     @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([releaseId, bucket, ts], map: "price_history_release_id_bucket_ts_key")
  @@index([releaseId, bucket, ts], map: "price_history_release_id_bucket_ts_idx")
  @@map("price_history")
}

model Wallet {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  assetCode    String              @map("asset_code")
  network      String
  address      String?
  status       WalletStatus        @default(ACTIVE)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  balance      WalletBalance?
  transactions WalletTransaction[]
  ledgerPostings LedgerPosting[]
  reconciliationDiscrepancies WalletReconciliationDiscrepancy[]
  depositAddresses          UserDepositAddress[]

  @@unique([userId, assetCode, network], map: "wallets_user_id_asset_code_network_key")
  @@index([userId], map: "wallets_user_id_idx")
  @@map("wallets")
}

model WalletBalance {
  walletId  String   @id @map("wallet_id") @db.Uuid
  available Decimal  @db.Decimal(20, 8)
  locked    Decimal  @db.Decimal(20, 8)
  pending   Decimal  @db.Decimal(20, 8)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_balances")
}

model WalletTransaction {
  id              String            @id @default(uuid()) @db.Uuid
  walletId        String            @map("wallet_id") @db.Uuid
  txType          WalletTxType      @map("tx_type")
  direction       WalletTxDirection
  amount          Decimal           @db.Decimal(20, 8)
  feeAmount       Decimal           @map("fee_amount") @db.Decimal(20, 8)
  netAmount       Decimal           @map("net_amount") @db.Decimal(20, 8)
  currency        String
  status          WalletTxStatus
  referenceType   String?           @map("reference_type")
  referenceId     String?           @map("reference_id") @db.Uuid
  operationType   LedgerOperationType? @map("operation_type")
  idempotencyKey  String?           @map("idempotency_key")
  actorUserId     String?           @map("actor_user_id") @db.Uuid
  actorRole       ActorRole?        @map("actor_role")
  reversalOfTxId  String?           @map("reversal_of_tx_id") @db.Uuid
  metadata        Json?             @map("metadata")
  happenedAt      DateTime          @map("happened_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  settledAt       DateTime?         @map("settled_at")
  wallet          Wallet            @relation(fields: [walletId], references: [id], onDelete: Restrict)
  reversalOfTx    WalletTransaction? @relation("wallet_tx_reversal", fields: [reversalOfTxId], references: [id], onDelete: SetNull)
  reversalTxs     WalletTransaction[] @relation("wallet_tx_reversal")
  deposit         Deposit?
  withdrawal      Withdrawal?
  ownershipLedger OwnershipLedger[]
  payouts         Payout[]
  fees            Fee[]
  ledgerPostings  LedgerPosting[]

  @@index([walletId, createdAt], map: "wallet_transactions_wallet_id_created_at_idx")
  @@index([walletId, happenedAt(sort: Desc)], map: "wallet_transactions_wallet_id_happened_at_idx")
  @@index([walletId, txType, status], map: "wallet_transactions_wallet_id_tx_type_status_idx")
  @@index([referenceType, referenceId], map: "wallet_transactions_reference_type_reference_id_idx")
  @@index([operationType, createdAt], map: "wallet_transactions_operation_type_created_at_idx")
  @@map("wallet_transactions")
}

model Deposit {
  id                    String                 @id @default(uuid()) @db.Uuid
  walletTxId            String                 @unique @map("wallet_tx_id") @db.Uuid
  blockchainTxid        String?                @unique @map("blockchain_txid")
  fromAddress           String?                @map("from_address")
  toAddress             String?                @map("to_address")
  confirmations         Int                    @default(0)
  requiredConfirmations Int                    @default(1) @map("required_confirmations")
  status                DepositStatus
  ingestionSource       DepositIngestionSource @default(MANUAL) @map("ingestion_source")
  suspiciousFlag        Boolean                @default(false) @map("suspicious_flag")
  providerBlockNumber   BigInt?                @map("provider_block_number")
  tokenContract         String?                @map("token_contract")
  ignoreReason          String?                @map("ignore_reason")
  receivedAt            DateTime?              @map("received_at")
  creditedAt            DateTime?              @map("credited_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  walletTx              WalletTransaction      @relation(fields: [walletTxId], references: [id], onDelete: Restrict)
  ingestionLogs         DepositIngestionLog[]

  @@index([status, createdAt], map: "deposits_status_created_at_idx")
  @@index([ingestionSource, createdAt], map: "deposits_ingestion_source_created_at_idx")
  @@map("deposits")
}

model DepositWatcherState {
  id               String               @id @default(uuid()) @db.Uuid
  network          String
  assetCode        String               @map("asset_code")
  lastScannedBlock BigInt               @default(0) @map("last_scanned_block")
  lastRunAt        DateTime?            @map("last_run_at")
  status           DepositWatcherStatus @default(IDLE)
  lastError        String?              @map("last_error")
