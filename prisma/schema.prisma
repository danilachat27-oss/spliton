  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  assignedTo       User?                 @relation("operator_sla_assignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([status, dueAt], map: "operator_sla_tasks_status_due_at_idx")
  @@index([taskType, status], map: "operator_sla_tasks_type_status_idx")
  @@index([assignedToUserId, status], map: "operator_sla_tasks_assignee_status_idx")
  @@unique([taskType, entityType, entityId], map: "operator_sla_tasks_unique_entity_key")
  @@map("operator_sla_tasks")
}

enum ReferralRewardStatus {
  PENDING
  QUALIFIED
  APPROVED
  REJECTED
  PAID
  CANCELLED
  HELD_FOR_REVIEW

  @@map("referral_reward_status")
}

enum ReferralRewardEventType {
  USER_REGISTERED
  EMAIL_VERIFIED
  KYC_COMPLETED
  FIRST_DEPOSIT
  FIRST_PRIMARY_PURCHASE
  SECONDARY_TRADE_FEE
  PLATFORM_FEE

  @@map("referral_reward_event_type")
}

enum ReferralRewardType {
  FIXED
  PERCENT_FEE

  @@map("referral_reward_type")
}

enum PartnerType {
  AFFILIATE
  INFLUENCER
  AGENCY
  ARTIST_MANAGER
  STRATEGIC_PARTNER

  @@map("partner_type")
}

enum PartnerStatus {
  APPLIED
  IN_REVIEW
  APPROVED
  REJECTED
  SUSPENDED

  @@map("partner_status")
}

enum PartnerTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  CUSTOM

  @@map("partner_tier")
}

model ReferralProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code], map: "referral_profiles_code_idx")
  @@map("referral_profiles")
}

model ReferralAttribution {
  id              String    @id @default(uuid()) @db.Uuid
  referredUserId  String    @unique @map("referred_user_id") @db.Uuid
  referrerUserId  String    @map("referrer_user_id") @db.Uuid
  referralCode    String    @map("referral_code")
  utmSource       String?   @map("utm_source")
  utmCampaign     String?   @map("utm_campaign")
  touchPolicy     String    @default("first_touch") @map("touch_policy")
  attributedAt    DateTime  @default(now()) @map("attributed_at")
  expiresAt       DateTime? @map("expires_at")
  referredUser    User      @relation("referral_referred", fields: [referredUserId], references: [id], onDelete: Cascade)
  referrer        User      @relation("referral_referrer", fields: [referrerUserId], references: [id], onDelete: Restrict)

  @@index([referrerUserId, attributedAt], map: "referral_attributions_referrer_at_idx")
  @@map("referral_attributions")
}

model ReferralRule {
  id              String                @id @default(uuid()) @db.Uuid
  eventType       ReferralRewardEventType @map("event_type")
  rewardType      ReferralRewardType    @map("reward_type")
  fixedAmount     Decimal?              @map("fixed_amount") @db.Decimal(20, 8)
  percentage      Decimal?              @db.Decimal(8, 4)
  currency        String                @default("USDT")
  partnerTier     PartnerTier?          @map("partner_tier")
  maxReward       Decimal?              @map("max_reward") @db.Decimal(20, 8)
  durationDays    Int?                  @map("duration_days")
  minDeposit      Decimal?              @map("min_deposit") @db.Decimal(20, 8)
  minPurchase     Decimal?              @map("min_purchase") @db.Decimal(20, 8)
  requiresKyc     Boolean               @default(false) @map("requires_kyc")
  requiresNoFraud Boolean               @default(true) @map("requires_no_fraud")
  active          Boolean               @default(true)
  effectiveFrom   DateTime?             @map("effective_from")
  effectiveTo     DateTime?             @map("effective_to")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  rewards         ReferralReward[]

  @@index([eventType, active], map: "referral_rules_event_active_idx")
  @@map("referral_rules")
}

model ReferralReward {
  id               String                @id @default(uuid()) @db.Uuid
  referrerUserId   String                @map("referrer_user_id") @db.Uuid
  referredUserId   String                @map("referred_user_id") @db.Uuid
  partnerProfileId String?               @map("partner_profile_id") @db.Uuid
  eventType        ReferralRewardEventType @map("event_type")
  sourceEntityType String?               @map("source_entity_type")
  sourceEntityId   String?               @map("source_entity_id") @db.Uuid
  amount           Decimal               @db.Decimal(20, 8)
  currency         String                @default("USDT")
  status           ReferralRewardStatus  @default(PENDING)
  ruleId           String?               @map("rule_id") @db.Uuid
  qualifiedAt      DateTime?             @map("qualified_at")
  approvedAt       DateTime?             @map("approved_at")
  paidAt           DateTime?             @map("paid_at")
  rejectedReason   String?               @map("rejected_reason") @db.Text
  metadata         Json?
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  referrer         User                  @relation("referral_reward_referrer", fields: [referrerUserId], references: [id], onDelete: Restrict)
  referred         User                  @relation("referral_reward_referred", fields: [referredUserId], references: [id], onDelete: Restrict)
  rule             ReferralRule?         @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  partnerProfile   PartnerProfile?       @relation(fields: [partnerProfileId], references: [id], onDelete: SetNull)

  @@unique([referrerUserId, referredUserId, eventType, sourceEntityId], map: "referral_rewards_dedup_uidx")
  @@index([referrerUserId, status, createdAt], map: "referral_rewards_referrer_status_idx")
  @@index([referredUserId], map: "referral_rewards_referred_idx")
  @@map("referral_rewards")
}

model PartnerProfile {
  id                 String         @id @default(uuid()) @db.Uuid
  userId             String         @unique @map("user_id") @db.Uuid
  partnerType        PartnerType    @map("partner_type")
  status             PartnerStatus  @default(APPLIED)
  tier               PartnerTier    @default(BRONZE)
  commissionPercent  Decimal?       @map("commission_percent") @db.Decimal(8, 4)
  customCommissionNote String?      @map("custom_commission_note") @db.Text
  payoutMethod       String?        @map("payout_method")
  applicationNote    String?        @map("application_note") @db.Text
  reviewedByUserId   String?        @map("reviewed_by_user_id") @db.Uuid
  approvedAt         DateTime?      @map("approved_at")
  rejectedReason     String?        @map("rejected_reason") @db.Text
  partnerCode        String?        @unique @map("partner_code")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewards            ReferralReward[]

  @@index([status, tier], map: "partner_profiles_status_tier_idx")
  @@map("partner_profiles")
}

model HelpCategory {
  id                     String         @id @default(uuid()) @db.Uuid
  slug                   String         @unique
  parentId               String?        @map("parent_id") @db.Uuid
  titleTranslations      Json           @default("{}") @map("title_translations")
  descriptionTranslations Json          @default("{}") @map("description_translations")
  icon                   String?
  sortOrder              Int            @default(0) @map("sort_order")
  isPublished            Boolean        @default(false) @map("is_published")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  parent                 HelpCategory?  @relation("help_category_tree", fields: [parentId], references: [id], onDelete: SetNull)
  children               HelpCategory[] @relation("help_category_tree")
  articles               HelpArticle[]

  @@index([parentId, sortOrder], map: "help_categories_parent_id_sort_order_idx")
  @@index([isPublished, sortOrder], map: "help_categories_is_published_sort_order_idx")
  @@map("help_categories")
}

model HelpArticle {
  id                  String            @id @default(uuid()) @db.Uuid
  slug                String            @unique
  categoryId          String?           @map("category_id") @db.Uuid
  titleTranslations   Json              @default("{}") @map("title_translations")
  excerptTranslations Json              @default("{}") @map("excerpt_translations")
  contentTranslations Json              @default("{}") @map("content_translations")
  status              HelpArticleStatus @default(DRAFT)
  sortOrder           Int               @default(0) @map("sort_order")
  isFeatured          Boolean           @default(false) @map("is_featured")
  isPopular           Boolean           @default(false) @map("is_popular")
  isGettingStarted    Boolean           @default(false) @map("is_getting_started")
  viewCount           Int               @default(0) @map("view_count")
  publishedAt         DateTime?         @map("published_at")
  authorUserId        String            @map("author_user_id") @db.Uuid
  metaTitle           String?           @map("meta_title")
  metaDescription     String?           @map("meta_description") @db.Text
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  category            HelpCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author              User              @relation("help_article_author", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([categoryId], map: "help_articles_category_id_idx")
  @@index([status], map: "help_articles_status_idx")
  @@index([sortOrder], map: "help_articles_sort_order_idx")
  @@index([isFeatured], map: "help_articles_is_featured_idx")
  @@index([isPopular], map: "help_articles_is_popular_idx")
  @@index([isGettingStarted], map: "help_articles_is_getting_started_idx")
  @@index([status, publishedAt], map: "help_articles_status_published_at_idx")
  @@map("help_articles")
}
