model Payout {
  id                    String              @id @default(uuid()) @db.Uuid
  userId                String              @map("user_id") @db.Uuid
  releaseId             String              @map("release_id") @db.Uuid
  earningDistributionId String              @map("earning_distribution_id") @db.Uuid
  walletTxId            String?             @unique @map("wallet_tx_id") @db.Uuid
  unitsEligible         Decimal             @map("units_eligible") @db.Decimal(20, 8)
  amountGross           Decimal             @map("amount_gross") @db.Decimal(20, 8)
  amountNet             Decimal             @map("amount_net") @db.Decimal(20, 8)
  status                PayoutStatus
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  user                  User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  release               Release             @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  earningDistribution   EarningDistribution @relation(fields: [earningDistributionId], references: [id], onDelete: Restrict)
  walletTransaction     WalletTransaction?  @relation(fields: [walletTxId], references: [id], onDelete: SetNull)
  payoutClaims          PayoutClaim[]

  @@index([userId, status], map: "payouts_user_id_status_idx")
  @@index([earningDistributionId], map: "payouts_earning_distribution_id_idx")
  @@map("payouts")
}

