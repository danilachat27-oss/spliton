    # Supabase + Prisma (see prisma/schema.prisma: url + directUrl)
# Dashboard → Project Settings → Database → Connection string
#
# DATABASE_URL — Transaction pooler, port 6543, add ?pgbouncer=true
#   postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# DIRECT_URL — Direct (migrations), host db.<PROJECT_REF>.supabase.co, port 5432 (NOT the pooler host)
#   postgresql://postgres.<PROJECT_REF>:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
#
# Error "tenant/user postgres.<ref> not found" → wrong PROJECT_REF or project paused/deleted.
DATABASE_URL=
DIRECT_URL=

# Isolated DB for backend e2e / CI (optional locally; required in CI secrets as BACKEND_E2E_*)
# jest-e2e.setup.ts maps TEST_DATABASE_URL → DATABASE_URL for the Jest process only.
# Dedicated Supabase project recommended (not shared dev/staging/prod).
# TEST_DATABASE_URL=
# TEST_DIRECT_URL=
# Local full e2e without TEST_DATABASE_URL (shared dev DB only — never staging/prod):
# ALLOW_E2E_ON_DATABASE_URL=1
# ALLOW_E2E_CLEANUP=1

# HTTP throttle (production always 120/min enabled)
# THROTTLE_TTL_SECONDS=60
# THROTTLE_LIMIT=120
# THROTTLE_ENABLED=true
# Load testing (non-production only): raised limit or disable throttle
# LOAD_TEST_MODE=true
# THROTTLE_LIMIT=10000

# Load baseline auth scenarios (read-only endpoints)
API_BASE_URL=http://localhost:4001
# LOAD_TEST_EMAIL=
# LOAD_TEST_PASSWORD=
# LOAD_TEST_TOKEN=
JWT_SECRET=
JWT_REFRESH_SECRET=
FRONTEND_ORIGIN=http://localhost:3000

# Frontend (apps/frontend) — public URLs only, no secrets
# NEXT_PUBLIC_APP_ENV=development  # development | staging | production (staging/prod builds require live + API URL)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4001  # required for staging/production; dev default http://localhost:4001
# NEXT_PUBLIC_ADMIN_API_BASE_URL=  # optional; defaults to API_BASE_URL
# NEXT_PUBLIC_ADMIN_DATA_SOURCE=mock  # mock | live — admin portal (staging/prod build requires live)
# NEXT_PUBLIC_WALLET_DATA_SOURCE=mock  # mock | live — wallet, orders, secondary market (root inheritance)
# NEXT_PUBLIC_CATALOG_DATA_SOURCE=live  # mock | live — catalog (inherits wallet if unset)
# NEXT_PUBLIC_MARKET_OVERVIEW_DATA_SOURCE=live  # mock | live — /catalog/market-overview (inherits catalog)
# NEXT_PUBLIC_RELEASE_ANALYTICS_DATA_SOURCE=live  # mock | live — /analytics/releases (inherits catalog)
# NEXT_PUBLIC_PORTFOLIO_DATA_SOURCE=live  # mock | live — assets overview/metrics/positions (inherits wallet)
# NEXT_PUBLIC_PAYOUTS_DATA_SOURCE=live  # mock | live — payouts section (inherits portfolio)
# NEXT_PUBLIC_SERVICES_DATA_SOURCE=live  # mock | live — calculator, partner gate (inherits wallet)
# NEXT_PUBLIC_AUTH_DATA_SOURCE=live  # mock | live — profile/account (inherits wallet)
# NEXT_PUBLIC_SUPPORT_DATA_SOURCE=live  # mock | live — user support tickets
# NEXT_PUBLIC_NEWS_DATA_SOURCE=live  # mock | live — public /news
# NEXT_PUBLIC_STATUS_DATA_SOURCE=live  # mock | live — public /system-status
# Staging/production: set all above to live — see apps/frontend/.env.staging.example
# NEXT_PUBLIC_TRON_EXPLORER_BASE_URL=  # optional; TronScan base for admin deposit tx links (e.g. https://tronscan.org)
# NEXT_PUBLIC_MIN_WITHDRAWAL_USDT=50  # optional UI hint
# MIN_WITHDRAWAL_USDT=50
# WITHDRAWAL_FEE_USDT=5
# DEPOSIT_INGESTION_ENABLED=false
# TRON_PROVIDER_MODE=mock  # mock | tron — production + DEPOSIT_INGESTION_ENABLED requires tron
# TRON_PROVIDER_URL=
# TRON_API_KEY=
# TRON_CONFIRMATIONS=20
# TRON_POLL_INTERVAL=15000
# Production boot guard (NODE_ENV=production): mock TRON forbidden when deposits+ingestion on
# EMAIL_PROVIDER=postmark|resend (required when FEATURE_ENABLE_EMAIL_DELIVERY=true in production)
# RESEND_API_KEY=
# Distributed rate limits (required for multi-instance 20k launch)
# REDIS_URL=redis://localhost:6379
# RATE_LIMIT_STORAGE=memory  # memory | redis
# RATE_LIMIT_MULTI_INSTANCE=false  # true in production with 2+ API instances
# PASSWORD_RESET_TOKEN_TTL_HOURS=1

# Report exports (backend): db | local | object | supabase
# REPORT_STORAGE_MODE=db    
# REPORT_STORAGE_BUCKET=
# REPORT_STORAGE_PUBLIC_URL=
# REPORT_STORAGE_ACCESS_KEY=
# REPORT_STORAGE_SECRET_KEY=
# REPORT_STORAGE_ENDPOINT=
# REPORT_STORAGE_REGION=auto
# REPORT_STORAGE_FORCE_PATH_STYLE=false

# Supabase Storage (backend only — SUPABASE_SERVICE_ROLE_KEY must never be in frontend)
# Dashboard → Project Settings → API
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_RELEASE_COVERS_BUCKET=release-covers
# SUPABASE_STORAGE_RELEASE_AUDIO_BUCKET=release-audio
# SUPABASE_STORAGE_REPORTS_BUCKET=reports
# SUPABASE_STORAGE_USER_DOCUMENTS_BUCKET=user-documents
AUTH_REFRESH_COOKIE_NAME=spliton_refresh_token
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_RETURN_REFRESH_TOKEN_IN_BODY=true
EMAIL_PROVIDER=dev
# Local dev helper: set true in real .env to fetch verifyUrl via /dev/email-outbox/latest
DEV_EMAIL_OUTBOX_ENABLED=false
EMAIL_FROM=
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=
RESEND_API_KEY=
APP_PUBLIC_URL=
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_HOURS=1
TWO_FACTOR_ENCRYPTION_KEY=
PORT=4001

# Report worker: off in local dev by default (NODE_ENV=development). Enable only when testing queues:
# REPORT_WORKER_ENABLED=true
# REPORT_WORKER_POLL_MS=15000
# REPORT_WORKER_MAX_ATTEMPTS=3
# REPORT_WORKER_TIMEOUT_MS=900000
# REPORT_RETENTION_DAYS=7

# Observability
# HEALTH_DEEP_TOKEN=
# ERROR_TRACKING_PROVIDER=console
# SENTRY_DSN=
# ERROR_TRACKING_ENVIRONMENT=staging
# ERROR_TRACKING_RELEASE=
# LOG_LEVEL=log

# Treasury (public addresses only — never private keys)
# SEED_TREASURY_ACCOUNTS_ON_BOOT=false
# TREASURY_HOT_WALLET_ADDRESS=
# TREASURY_COLD_WALLET_ADDRESS=
# TREASURY_HOT_MIN_BALANCE_USDT=1000
# TREASURY_HOT_MAX_BALANCE_USDT=50000

# Kill switches (backend FeatureFlagsService)
# KILL_SWITCH_DISABLE_WITHDRAWALS=false
# KILL_SWITCH_DISABLE_DEPOSITS=false
# KILL_SWITCH_DISABLE_DEPOSIT_CREDIT=false
# KILL_SWITCH_DISABLE_PRIMARY_PURCHASES=false
# KILL_SWITCH_DISABLE_SECONDARY_TRADING=false
# KILL_SWITCH_DISABLE_REVENUE_DISTRIBUTION=false
# KILL_SWITCH_DISABLE_REPORT_DOWNLOADS=false
# FEATURE_MAINTENANCE_MODE=false
